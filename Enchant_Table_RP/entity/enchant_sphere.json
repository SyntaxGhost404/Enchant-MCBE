// Enchant+ 1.1.1 for Minecraft: Bedrock Edition 26.60+
// Look of the floating sphere: model, texture and idle animation.
//
// Based on Enchant+ by Death_Aruban: https://github.com/DeathAruban/Enchant-MCBE

{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "da:enchant_sphere",
			"materials": { "default": "entity_emissive" },
			"textures": { "default": "arucube/enchant_table/resources/entity/enchant_sphere" },
			"geometry": { "default": "geometry.enchant_sphere" },
			"render_controllers": ["controller.render.da_enchant_sphere"],
			"animations": {
				"idle": "animation.enchant_sphere.idle",
				"ctrl": "controller.animation.enchant_sphere"
			},
			"scripts": {
				"animate": [
					{ "idle": "query.is_alive" },
					{ "ctrl": "query.is_alive" }
				],
				"initialize": ["query.is_alive"]
			}
		}
	}
}