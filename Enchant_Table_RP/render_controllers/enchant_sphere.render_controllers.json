// husk's controller, which other packs (and newer game versions) can change, causing content log errors.
//
// Based on Enchant+ by Death_Aruban: https://github.com/DeathAruban/Enchant-MCBE

{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.da_enchant_sphere": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.default" ]
    }
  }
}
