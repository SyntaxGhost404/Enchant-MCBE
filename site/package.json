{
  "name": "enchant-plus-site",
  "description": "Companion website for the Enchant+ add-on: guide, downloads, price calculator and bug reports. Reads the add-on's own files.",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "assets": "node scripts/package-addon.mjs && node scripts/notices.mjs",
    "predev": "npm run assets",
    "dev": "vite dev",
    "prebuild": "npm run assets",
    "build": "vite build && node scripts/check-site.mjs",
    "preview": "vite preview",
    "check": "npm run assets && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "fflate": "0.8.3",
    "pixelarticons": "2.4.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
