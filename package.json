{
  "name": "vein-miner-ore-smelter",
  "description": "Vein Miner and Ore Smelter enchantments for Minecraft: Bedrock Edition, written against the stable Script API.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "loot": "python3 tools/loot.py",
    "validate": "python3 tools/validate.py",
    "package": "python3 tools/package.py",
    "all": "npm run check && npm test && npm run build && npm run loot -- --check && npm run validate && npm run package"
  },
  "devDependencies": {
    "@minecraft/common": "1.2.0",
    "@minecraft/server": "2.11.0",
    "@minecraft/server-ui": "2.3.0",
    "@minecraft/vanilla-data": "1.26.60",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
