/**
 * Enchant+ 1.1.0 for Minecraft: Bedrock Edition 26.60+
 * The floating sphere above each table. It cannot be hurt or pushed; the scripts remove it through
 * its "despawn" event.
 *
 * Based on Enchant+ by Death_Aruban: https://github.com/DeathAruban/Enchant-MCBE
 */

{
	"format_version": "1.26.60",
	"minecraft:entity": {
		"description": { "identifier": "da:enchant_sphere", "is_summonable": true, "is_spawnable": false, "is_experimental": false },
		"component_groups": {"despawn": { "minecraft:instant_despawn": {} }},
		"components": {
			"minecraft:damage_sensor": { "triggers": [{"cause": "all","deals_damage": "no"}]},
			"minecraft:collision_box": {"width": 0,"height": 0},
			"minecraft:physics": { "has_collision": true,"has_gravity": false},
			"minecraft:nameable": { "always_show": false, "allow_name_tag_renaming": false },
			"minecraft:type_family": {"family": ["mob"]}
		},
		"events": { "despawn":  {"add": {"component_groups": ["despawn"]} }}
	}
}