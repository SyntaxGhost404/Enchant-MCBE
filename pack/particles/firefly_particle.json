{
	"format_version": "1.26.10",
	"particle_effect": {
		"description": {
			"identifier": "minecraft:firefly_particle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/gloamlight_mote"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.acceleration_x = math.random( -5, 5 ); v.acceleration_y = math.random( -5, 5 ); v.acceleration_z = math.random( -5, 5 );",
				"per_update_expression": "v.should_change = math.random( 0, 1 ) <= 0.05; v.should_change ? ( v.acceleration_x = math.random( -5, 5 ) ); v.should_change ? ( v.acceleration_y = math.random( -5, 5 ) ); v.should_change ? ( v.acceleration_z = math.random( -5, 5 ) );"
			},
			"minecraft:emitter_lifetime_once": {},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"query.is_pack_setting_enabled('gloamlight:fireflies') ? 0.085 : 0.03",
					"query.is_pack_setting_enabled('gloamlight:fireflies') ? 0.085 : 0.03"
				],
				"facing_camera_mode": "lookat_xyz",
				"direction": {
					"mode": "derive_from_velocity",
					"custom_direction": [
						0,
						0,
						0
					],
					"min_speed_threshold": 0.1
				},
				"uv": {
					"texture_width": 1,
					"texture_height": 1,
					"uv": [
						0,
						0
					],
					"uv_size": [
						1,
						1
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					1.0,
					0.96,
					0.62,
					"math.clamp(math.min(v.particle_age / (v.particle_lifetime * 0.3), (v.particle_lifetime - v.particle_age) / (v.particle_lifetime * 0.5)), 0, 1) * (query.is_pack_setting_enabled('gloamlight:fireflies') ? (0.62 + 0.38 * math.sin(v.particle_age * 140 + v.particle_random_1 * 360)) : 1)"
				]
			},
			"minecraft:particle_initial_speed": 0.5,
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random( 10, 15 )"
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 2,
				"collision_radius": 0.0375,
				"events": []
			},
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"v.acceleration_x",
					"v.acceleration_y",
					"v.acceleration_z"
				],
				"linear_drag_coefficient": 3
			}
		}
	}
}
